# Copy to .env only when local overrides are needed. Never commit real credentials.
# Replace YOUR_MACOS_USERNAME with the result of `id -un`.
DATABASE_URL=postgres://YOUR_MACOS_USERNAME@127.0.0.1/djswift_development?tlsmode=disable
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_KEY_NAMESPACE=djswift:development

# Optional Soto S3 asset storage. Leave both unset to disable it locally.
# AWS_REGION=us-east-2
# AWS_S3_ASSET_BUCKET=djswift-development-assets
